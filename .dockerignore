# 构建上下文排除项（镜像只带程序与自带资产）
.git
.gitignore
node_modules
data
*.log
.DS_Store
**/.DS_Store
# 打包产物不进镜像
dist/
dist-min/
# 本地 public/ 是 web/dist 的拷贝（调试 8077 用）。镜像里的 /app/public 由
# Stage1 的 vite build 现场产出，不能拿本地这份顶替
public/
# 前端本地依赖与构建产物不进镜像（构建阶段会重新 npm ci + vite build）
web/node_modules
web/dist
# 用户自定义资产不进镜像（走 /custom 挂载）
custom/
